# QueryGenie talks to any OpenAI-compatible LLM endpoint. All options below are free.

# Option 1 (default): Google Gemini free tier. Get a key at https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
# Free models are sometimes overloaded; the agent switches to these (comma-separated) when that happens.
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite

# Option 2: Groq free tier (https://console.groq.com/keys). Lower token limits, so runs are slower.
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Option 3: fully local with Ollama (https://ollama.com), no key needed: `ollama pull qwen3:8b`
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b

# Optional: analyse your own SQLite database instead of the Northwind demo.
# DATABASE_PATH=/path/to/your.db
